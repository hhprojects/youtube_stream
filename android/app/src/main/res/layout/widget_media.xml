<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_music_note"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_title"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Nothing playing" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_subtitle"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_up_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_subtitle"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView android:id="@+id/widget_shuffle"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:scaleType="centerInside" android:src="@drawable/ic_widget_shuffle"
            android:contentDescription="Shuffle" />

        <ImageView android:id="@+id/widget_previous"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:scaleType="centerInside" android:src="@drawable/ic_widget_previous"
            android:contentDescription="Previous" />

        <ImageView android:id="@+id/widget_play_pause"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:scaleType="centerInside" android:src="@drawable/ic_widget_play"
            android:contentDescription="Play/Pause" />

        <ImageView android:id="@+id/widget_next"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:scaleType="centerInside" android:src="@drawable/ic_widget_next"
            android:contentDescription="Next" />

        <ImageView android:id="@+id/widget_repeat"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:scaleType="centerInside" android:src="@drawable/ic_widget_repeat"
            android:contentDescription="Repeat" />
    </LinearLayout>
</LinearLayout>
