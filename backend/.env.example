# Backend (Raspberry Pi) configuration.
# Copy this file to `.env` in the same directory:  cp .env.example .env
# Never commit the real `.env`.

# Host:port the Pi advertises in /api/download and /api/library responses.
# Must be reachable from the phone (LAN IP, or Tailscale IP if you use Tailscale).
#   Home LAN:   <PI_LAN_IP>:3001        (your Pi's actual LAN IP — `hostname -I`)
#   Tailscale:  <PI_TAILSCALE_IP>:3001  (your Pi's Tailscale IP — `tailscale ip -4`)
SERVER_URL=<PI_IP>:3001

# Listen port for the Express server.
BACKEND_PORT=3001

# Where yt-dlp writes m4a files. Defaults to `<backend>/downloads` if unset.
# DOWNLOAD_DIR=./downloads

# Max total size of DOWNLOAD_DIR in bytes. Oldest files prune above this.
# Default: 2 GiB. Raise it if your Pi's SD card has room.
DOWNLOADS_MAX_BYTES=2147483648
